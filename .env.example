# Copy to .env before docker compose up. .env is gitignored. These values are local placeholders, not production secrets.

POSTGRES_USER=blood
POSTGRES_PASSWORD=change-me
DONNEURS_DB_NAME=donneurs
DEMANDES_DB_NAME=demandes
STOCK_DB_NAME=stock
CNTS_DB_NAME=cnts

SPRING_PROFILES_ACTIVE=demo

SERVER_PORT_GATEWAY=8080
SERVER_PORT_DONNEURS=8081
SERVER_PORT_DEMANDES=8082
SERVER_PORT_DON_STOCK=8083
SERVER_PORT_CNTS=8084
GRPC_PORT=9090

DONNEURS_URL=http://service-donneurs:8081
DEMANDES_URL=http://service-demandes:8082
DON_STOCK_GRPC_TARGET=static://service-don-stock:9090
CNTS_URL=http://service-cnts:8084/ws

GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=10s
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-secret

GRPC_DEADLINE_MS=2000
SOAP_TIMEOUT_MS=3000
RETRY_JOBS_INTERVAL_SEC=60

CNTS_LATENCY_MS=0
CNTS_FAIL_RATE=0.0

AGE_MIN=18
AGE_MAX=70
AGE_PREMIER_DON_MAX=65
POIDS_MIN_KG=50
VOLUME_PRELEVEMENT_ML=450
REPOS_MIN_MINUTES=15
CRENEAU_CAPACITE_DEFAUT=4
COMPENSATION_MIN=2
COMPENSATION_MAX=3
DELAI_QUALIFICATION_SEC=20
DELAI_LIVRAISON_SEC=30

# Reserved for the frontend and the login bonus. Not enforced yet.
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MOCKS=false
DEMO_DONOR_USER=donor
DEMO_DONOR_PASSWORD=change-me
DEMO_STAFF_USER=staff
DEMO_STAFF_PASSWORD=change-me
DEMO_HOPITAL_USER=hopital
DEMO_HOPITAL_PASSWORD=change-me
DEMO_ADMIN_USER=admin
