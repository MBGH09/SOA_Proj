<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://iit.tn/soa/cnts"
           targetNamespace="http://iit.tn/soa/cnts"
           elementFormDefault="qualified">

    <!-- ===========================================================
         CNTS (Centre National de Transfusion Sanguine) — SOAP Contract
         Namespace  : http://iit.tn/soa/cnts
         Operations : enregistrerPrelevement
                      demanderApprovisionnement
                      delivrerCertificatDon
         Author     : Student 5 — service-cnts
         =========================================================== -->

    <!-- ==================== TYPES SIMPLES ==================== -->

    <xs:simpleType name="GroupeSanguin">
        <xs:restriction base="xs:string">
            <xs:enumeration value="A_POS"/>
            <xs:enumeration value="A_NEG"/>
            <xs:enumeration value="B_POS"/>
            <xs:enumeration value="B_NEG"/>
            <xs:enumeration value="AB_POS"/>
            <xs:enumeration value="AB_NEG"/>
            <xs:enumeration value="O_POS"/>
            <xs:enumeration value="O_NEG"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Composant">
        <xs:restriction base="xs:string">
            <xs:enumeration value="CGR"/>        <!-- Concentré de Globules Rouges -->
            <xs:enumeration value="PLASMA"/>
            <xs:enumeration value="PLAQUETTES"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Urgence">
        <xs:restriction base="xs:string">
            <xs:enumeration value="NORMALE"/>
            <xs:enumeration value="HAUTE"/>
            <xs:enumeration value="CRITIQUE"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ==================== OPERATION 1 : enregistrerPrelevement ====================
         Déclare un don collecté au système CNTS.
         Retourne un numéro de don national unique (idempotent par donIdLocal).
         Fault : PrelevementInvalideFault (volume ≠ 450 ml, groupe inconnu, date future)
    -->

    <xs:element name="enregistrerPrelevementRequest">
        <xs:complexType>
            <xs:sequence>
                <!-- Identifiant local du don dans service-donneurs (clé d'idempotence) -->
                <xs:element name="donIdLocal"      type="xs:string"/>
                <xs:element name="groupeSanguin"   type="tns:GroupeSanguin"/>
                <!-- Doit être égal à VOLUME_PRELEVEMENT_ML (450). Fault sinon. -->
                <xs:element name="volumeMl"        type="xs:int"/>
                <xs:element name="centreId"        type="xs:string"/>
                <!-- Date de prélèvement — ne peut pas être dans le futur -->
                <xs:element name="datePrelevement" type="xs:date"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="enregistrerPrelevementResponse">
        <xs:complexType>
            <xs:sequence>
                <!-- Numéro national unique généré (ex: DN-2026-000001) -->
                <xs:element name="numeroDonNational" type="xs:string"/>
                <!-- Toujours QUALIFICATION_EN_COURS à la déclaration -->
                <xs:element name="statut"            type="xs:string"/>
                <!-- Composants prévus après qualification : CGR, PLASMA, PLAQUETTES -->
                <xs:element name="composantsPrevus"  type="xs:string"
                            minOccurs="1" maxOccurs="3"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Fault : volume invalide, groupe inconnu ou date future -->
    <xs:element name="PrelevementInvalideFault">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code"    type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ==================== OPERATION 2 : demanderApprovisionnement ====================
         Commande de sang au stock central (essai CRTS de la région, puis CNTS Tunis).
         Idempotent par demandeId (Gap 5) : même demandeId → même référence.
         Fault : StockCentralInsuffisantFault (ni CRTS ni CNTS ne peuvent fournir)
    -->

    <xs:element name="demanderApprovisionnementRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="hopitalId"     type="xs:string"/>
                <!-- Région pour choisir le CRTS (ex: SFAX, TUNIS, SOUSSE) -->
                <xs:element name="region"        type="xs:string"/>
                <xs:element name="groupeSanguin" type="tns:GroupeSanguin"/>
                <xs:element name="composant"     type="tns:Composant"/>
                <!-- Quantité en nombre de poches (minimum 1) -->
                <xs:element name="quantite"      type="xs:int"/>
                <xs:element name="urgence"       type="tns:Urgence"/>
                <!-- Clé d'idempotence (Gap 5) — un retry ne crée pas 2 commandes -->
                <xs:element name="demandeId"     type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="demanderApprovisionnementResponse">
        <xs:complexType>
            <xs:sequence>
                <!-- Référence unique de la commande (ex: APP-2026-000001) -->
                <xs:element name="reference"        type="xs:string"/>
                <!-- Quantité accordée (tout ou rien en v2) -->
                <xs:element name="quantiteAccordee" type="xs:int"/>
                <!-- CRTS-SFAX ou CNTS-TUNIS selon qui a fourni -->
                <xs:element name="centreSource"     type="xs:string"/>
                <!-- Délai en minutes (plus court pour CRITIQUE) -->
                <xs:element name="delaiMinutes"     type="xs:int"/>
                <xs:element name="statut"           type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Fault : ni le CRTS ni le CNTS ne peuvent fournir la quantité demandée -->
    <xs:element name="StockCentralInsuffisantFault">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code"    type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ==================== OPERATION 3 : delivrerCertificatDon ====================
         Émet le certificat de don officiel après qu'une visite soit TERMINEE.
         Idempotent par donIdLocal (R25) : un don = un certificat.
         Fault : CertificatRefuseFault (don inconnu ou non déclaré)
    -->

    <xs:element name="delivrerCertificatDonRequest">
        <xs:complexType>
            <xs:sequence>
                <!-- Clé d'idempotence : un donIdLocal = un certificat (R25) -->
                <xs:element name="donIdLocal"        type="xs:string"/>
                <!-- Numéro national reçu lors de enregistrerPrelevement -->
                <xs:element name="numeroDonNational" type="xs:string"/>
                <!-- Référence anonyme du donneur (pas de nom, pas de CIN) R27 -->
                <xs:element name="donneurRef"        type="xs:string"/>
                <xs:element name="centreId"          type="xs:string"/>
                <xs:element name="dateDon"           type="xs:date"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="delivrerCertificatDonResponse">
        <xs:complexType>
            <xs:sequence>
                <!-- Numéro unique du certificat (ex: CERT-2026-000001) -->
                <xs:element name="numeroCertificat" type="xs:string"/>
                <xs:element name="dateEmission"     type="xs:date"/>
                <!-- Toujours VALIDE -->
                <xs:element name="statut"           type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Fault : don inconnu ou non déclaré via enregistrerPrelevement -->
    <xs:element name="CertificatRefuseFault">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code"    type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>

