      <wsdl:fault name="PrelevementInvalideFault">
        <soap:fault name="PrelevementInvalideFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="delivrerCertificatDon">
      <soap:operation soapAction=""/>
      <wsdl:input name="delivrerCertificatDonRequest">
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="delivrerCertificatDonResponse">
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="CntsPortService">
