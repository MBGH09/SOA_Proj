<?xml version="1.0" encoding="UTF-8" standalone="no"?><wsdl:definitions xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/" xmlns:sch="http://iit.tn/soa/cnts" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:tns="http://iit.tn/soa/cnts" targetNamespace="http://iit.tn/soa/cnts">
  <wsdl:types>
    <xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="http://iit.tn/soa/cnts">

    <!-- ===========================================================
         CNTS (Centre National de Transfusion Sanguine) - SOAP Contract
         Namespace  : http://iit.tn/soa/cnts
         Operations : enregistrerPrelevement
                      demanderApprovisionnement
                      delivrerCertificatDon
         Author     : Student 5 - service-cnts
         =========================================================== -->

    <!-- ==================== TYPES SIMPLES ==================== -->

    <xs:simpleType name="GroupeSanguin">
        <xs:restriction base="xs:string">
            <xs:enumeration value="A_POS"/>
            <xs:enumeration value="A_NEG"/>
            <xs:enumeration value="B_POS"/>
            <xs:enumeration value="B_NEG"/>
            <xs:enumeration value="AB_POS"/>
            <xs:enumeration value="AB_NEG"/>
            <xs:enumeration value="O_POS"/>
            <xs:enumeration value="O_NEG"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Composant">
        <xs:restriction base="xs:string">
            <xs:enumeration value="CGR"/>
            <xs:enumeration value="PLASMA"/>
            <xs:enumeration value="PLAQUETTES"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="Urgence">
        <xs:restriction base="xs:string">
            <xs:enumeration value="NORMALE"/>
            <xs:enumeration value="HAUTE"/>
            <xs:enumeration value="CRITIQUE"/>
        </xs:restriction>
    </xs:simpleType>

    <!-- ==================== OPERATION 1 : enregistrerPrelevement ==================== -->

    <xs:element name="enregistrerPrelevementRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="donIdLocal" type="xs:string"/>
                <xs:element name="groupeSanguin" type="tns:GroupeSanguin"/>
                <xs:element name="volumeMl" type="xs:int"/>
                <xs:element name="centreId" type="xs:string"/>
                <xs:element name="datePrelevement" type="xs:date"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="enregistrerPrelevementResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="numeroDonNational" type="xs:string"/>
                <xs:element name="statut" type="xs:string"/>
                <xs:element maxOccurs="3" minOccurs="1" name="composantsPrevus" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="PrelevementInvalideFault">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code" type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ==================== OPERATION 2 : demanderApprovisionnement ==================== -->

    <xs:element name="demanderApprovisionnementRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="hopitalId" type="xs:string"/>
                <xs:element name="region" type="xs:string"/>
                <xs:element name="groupeSanguin" type="tns:GroupeSanguin"/>
                <xs:element name="composant" type="tns:Composant"/>
                <xs:element name="quantite" type="xs:int"/>
                <xs:element name="urgence" type="tns:Urgence"/>
                <xs:element name="demandeId" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="demanderApprovisionnementResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="reference" type="xs:string"/>
                <xs:element name="quantiteAccordee" type="xs:int"/>
                <xs:element name="centreSource" type="xs:string"/>
                <xs:element name="delaiMinutes" type="xs:int"/>
                <xs:element name="statut" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="StockCentralInsuffisantFault">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code" type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- ==================== OPERATION 3 : delivrerCertificatDon ==================== -->

    <xs:element name="delivrerCertificatDonRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="donIdLocal" type="xs:string"/>
                <xs:element name="numeroDonNational" type="xs:string"/>
                <xs:element name="donneurRef" type="xs:string"/>
                <xs:element name="centreId" type="xs:string"/>
                <xs:element name="dateDon" type="xs:date"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="delivrerCertificatDonResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="numeroCertificat" type="xs:string"/>
                <xs:element name="dateEmission" type="xs:date"/>
                <xs:element name="statut" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <xs:element name="CertificatRefuseFault">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code" type="xs:string"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
  </wsdl:types>
  <wsdl:message name="demanderApprovisionnementRequest">
    <wsdl:part element="tns:demanderApprovisionnementRequest" name="demanderApprovisionnementRequest">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="enregistrerPrelevementResponse">
    <wsdl:part element="tns:enregistrerPrelevementResponse" name="enregistrerPrelevementResponse">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="StockCentralInsuffisantFault">
    <wsdl:part element="tns:StockCentralInsuffisantFault" name="StockCentralInsuffisantFault">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="CertificatRefuseFault">
    <wsdl:part element="tns:CertificatRefuseFault" name="CertificatRefuseFault">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="demanderApprovisionnementResponse">
    <wsdl:part element="tns:demanderApprovisionnementResponse" name="demanderApprovisionnementResponse">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="PrelevementInvalideFault">
    <wsdl:part element="tns:PrelevementInvalideFault" name="PrelevementInvalideFault">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="enregistrerPrelevementRequest">
    <wsdl:part element="tns:enregistrerPrelevementRequest" name="enregistrerPrelevementRequest">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="delivrerCertificatDonResponse">
    <wsdl:part element="tns:delivrerCertificatDonResponse" name="delivrerCertificatDonResponse">
    </wsdl:part>
  </wsdl:message>
  <wsdl:message name="delivrerCertificatDonRequest">
    <wsdl:part element="tns:delivrerCertificatDonRequest" name="delivrerCertificatDonRequest">
    </wsdl:part>
  </wsdl:message>
  <wsdl:portType name="CntsPort">
    <wsdl:operation name="demanderApprovisionnement">
      <wsdl:input message="tns:demanderApprovisionnementRequest" name="demanderApprovisionnementRequest">
    </wsdl:input>
      <wsdl:output message="tns:demanderApprovisionnementResponse" name="demanderApprovisionnementResponse">
    </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="enregistrerPrelevement">
      <wsdl:input message="tns:enregistrerPrelevementRequest" name="enregistrerPrelevementRequest">
    </wsdl:input>
      <wsdl:output message="tns:enregistrerPrelevementResponse" name="enregistrerPrelevementResponse">
    </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="StockCentralInsuffisant">
      <wsdl:fault message="tns:StockCentralInsuffisantFault" name="StockCentralInsuffisantFault">
    </wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="CertificatRefuse">
      <wsdl:fault message="tns:CertificatRefuseFault" name="CertificatRefuseFault">
    </wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="PrelevementInvalide">
      <wsdl:fault message="tns:PrelevementInvalideFault" name="PrelevementInvalideFault">
    </wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="delivrerCertificatDon">
      <wsdl:input message="tns:delivrerCertificatDonRequest" name="delivrerCertificatDonRequest">
    </wsdl:input>
      <wsdl:output message="tns:delivrerCertificatDonResponse" name="delivrerCertificatDonResponse">
    </wsdl:output>
    </wsdl:operation>
  </wsdl:portType>
  <wsdl:binding name="CntsPortSoap11" type="tns:CntsPort">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>
    <wsdl:operation name="demanderApprovisionnement">
      <soap:operation soapAction=""/>
      <wsdl:input name="demanderApprovisionnementRequest">
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="demanderApprovisionnementResponse">
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="enregistrerPrelevement">
      <soap:operation soapAction=""/>
      <wsdl:input name="enregistrerPrelevementRequest">
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="enregistrerPrelevementResponse">
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
    <wsdl:operation name="StockCentralInsuffisant">
      <soap:operation soapAction=""/>
      <wsdl:fault name="StockCentralInsuffisantFault">
        <soap:fault name="StockCentralInsuffisantFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="CertificatRefuse">
      <soap:operation soapAction=""/>
      <wsdl:fault name="CertificatRefuseFault">
        <soap:fault name="CertificatRefuseFault" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>
    <wsdl:operation name="PrelevementInvalide">
