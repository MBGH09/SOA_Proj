<?xml version="1.0" encoding="UTF-8"?>
<!--
  WSDL du service-cnts (CNTS - Centre National de Transfusion Sanguine)
  ======================================================================
  Ce fichier est le CONTRAT OFFICIEL entre service-cnts (Student 5)
  et service-don-stock (Student 4).

  Opérations :
    1. enregistrerPrelevement    → fault: PrelevementInvalide
    2. demanderApprovisionnement → fault: StockCentralInsuffisant
    3. delivrerCertificatDon     → fault: CertificatRefuse

  Style   : document/literal (standard SOA)
  Port    : 8084
  URL     : http://<host>:8084/ws/cnts.wsdl
-->
<wsdl:definitions
    xmlns:wsdl="http://schemas.xmlsoap.org/wsdl/"
    xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/"
    xmlns:tns="http://iit.tn/soa/cnts"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://iit.tn/soa/cnts"
    name="cnts">

  <!-- ================================================================
       TYPES : on importe le XSD séparé (source de vérité du schéma)
       ================================================================ -->
  <wsdl:types>
    <xs:schema>
      <xs:import namespace="http://iit.tn/soa/cnts" schemaLocation="cnts.xsd"/>
    </xs:schema>
  </wsdl:types>

  <!-- ================================================================
       MESSAGES : un message = un élément du XSD
       ================================================================ -->

  <!-- Opération 1 : enregistrerPrelevement -->
  <wsdl:message name="EnregistrerPrelevementRequest">
    <wsdl:part name="parameters" element="tns:enregistrerPrelevementRequest"/>
  </wsdl:message>
  <wsdl:message name="EnregistrerPrelevementResponse">
    <wsdl:part name="parameters" element="tns:enregistrerPrelevementResponse"/>
  </wsdl:message>
  <wsdl:message name="PrelevementInvalideFault">
    <wsdl:part name="fault" element="tns:PrelevementInvalideFault"/>
  </wsdl:message>

  <!-- Opération 2 : demanderApprovisionnement -->
  <wsdl:message name="DemanderApprovisionnementRequest">
    <wsdl:part name="parameters" element="tns:demanderApprovisionnementRequest"/>
  </wsdl:message>
  <wsdl:message name="DemanderApprovisionnementResponse">
    <wsdl:part name="parameters" element="tns:demanderApprovisionnementResponse"/>
  </wsdl:message>
  <wsdl:message name="StockCentralInsuffisantFault">
    <wsdl:part name="fault" element="tns:StockCentralInsuffisantFault"/>
  </wsdl:message>

  <!-- Opération 3 : delivrerCertificatDon -->
  <wsdl:message name="DelivrerCertificatDonRequest">
    <wsdl:part name="parameters" element="tns:delivrerCertificatDonRequest"/>
  </wsdl:message>
  <wsdl:message name="DelivrerCertificatDonResponse">
    <wsdl:part name="parameters" element="tns:delivrerCertificatDonResponse"/>
  </wsdl:message>
  <wsdl:message name="CertificatRefuseFault">
    <wsdl:part name="fault" element="tns:CertificatRefuseFault"/>
  </wsdl:message>

  <!-- ================================================================
       PORT TYPE : interface abstraite du service
       Chaque opération déclare ses faults possibles ici
       ================================================================ -->
  <wsdl:portType name="CntsPortType">

    <!-- Opération 1 -->
    <wsdl:operation name="enregistrerPrelevement">
      <wsdl:input  message="tns:EnregistrerPrelevementRequest"/>
      <wsdl:output message="tns:EnregistrerPrelevementResponse"/>
      <wsdl:fault  name="PrelevementInvalide"
                   message="tns:PrelevementInvalideFault"/>
    </wsdl:operation>

    <!-- Opération 2 -->
    <wsdl:operation name="demanderApprovisionnement">
      <wsdl:input  message="tns:DemanderApprovisionnementRequest"/>
      <wsdl:output message="tns:DemanderApprovisionnementResponse"/>
      <wsdl:fault  name="StockCentralInsuffisant"
                   message="tns:StockCentralInsuffisantFault"/>
    </wsdl:operation>

    <!-- Opération 3 -->
    <wsdl:operation name="delivrerCertificatDon">
      <wsdl:input  message="tns:DelivrerCertificatDonRequest"/>
      <wsdl:output message="tns:DelivrerCertificatDonResponse"/>
      <wsdl:fault  name="CertificatRefuse"
                   message="tns:CertificatRefuseFault"/>
    </wsdl:operation>

  </wsdl:portType>

  <!-- ================================================================
       BINDING : comment les messages sont transportés (SOAP 1.1)
       Chaque fault du portType est répété ici avec soap:fault
       ================================================================ -->
  <wsdl:binding name="CntsPortSoap11" type="tns:CntsPortType">
    <soap:binding style="document" transport="http://schemas.xmlsoap.org/soap/http"/>

    <!-- Opération 1 -->
    <wsdl:operation name="enregistrerPrelevement">
      <soap:operation soapAction=""/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
      <wsdl:fault name="PrelevementInvalide">
        <soap:fault name="PrelevementInvalide" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>

    <!-- Opération 2 -->
    <wsdl:operation name="demanderApprovisionnement">
      <soap:operation soapAction=""/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
      <wsdl:fault name="StockCentralInsuffisant">
        <soap:fault name="StockCentralInsuffisant" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>

    <!-- Opération 3 -->
    <wsdl:operation name="delivrerCertificatDon">
      <soap:operation soapAction=""/>
      <wsdl:input>
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output>
        <soap:body use="literal"/>
      </wsdl:output>
      <wsdl:fault name="CertificatRefuse">
        <soap:fault name="CertificatRefuse" use="literal"/>
      </wsdl:fault>
    </wsdl:operation>

  </wsdl:binding>

  <!-- ================================================================
       SERVICE : adresse physique du endpoint
       ================================================================ -->
  <wsdl:service name="CntsService">
    <wsdl:port name="CntsPortSoap11" binding="tns:CntsPortSoap11">
      <soap:address location="http://localhost:8084/ws"/>
    </wsdl:port>
  </wsdl:service>

</wsdl:definitions>

